# 服务端口（默认 8787）
PORT=8787

# 必填：JWT 签名密钥（HS256），生产环境用随机字符串，如 openssl rand -hex 32
JWT_SECRET=

# SQLite 数据库文件路径（默认 ./data/zhizhi.db）
DB_PATH=./data/zhizhi.db

# 验证码发送通道：log（默认，MVP 输出到日志）| email（待接入）；仅邮箱注册，无 sms
VERIFY_CODE=log

# CORS 允许的 Origin 白名单（逗号分隔）。生产默认 tauri://localhost 等；
# 需要自定义（如自托管域名）时设置；开发/测试留空则允许所有 Origin
CORS_ORIGIN=

# development | production（production 隐藏内部错误细节）
NODE_ENV=development
